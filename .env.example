# Supabase — コピーして .env.local を作成し、ダッシュボードの値を入れてください
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# サーバー専用（ブラウザに出さない）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# 表示名（profiles.name）の AES-256-GCM 暗号化鍵（Base64 32バイト）
# 生成例: openssl rand -base64 32
# サーバー専用。NEXT_PUBLIC_ は付けない。紛失すると既存暗号名を復号できない
PROFILE_NAME_ENCRYPTION_KEY=

# OpenAI（体調相談チャット）— サーバー専用。NEXT_PUBLIC_ は付けない
# モデルは gpt-4o-mini 固定（アプリ側）
OPENAI_API_KEY=
